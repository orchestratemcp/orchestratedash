{
  "name": "orchestratedash",
  "version": "0.1.1",
  "private": true,
  "description": "Telemetry v1 and Agent DOM v2 contracts plus the local monitor app for OrchestrateDASH.",
  "type": "module",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:shell": "node scripts/build-shell.mjs",
    "shell": "pnpm build:shell && electron .",
    "shell:smoke": "pnpm build:shell && electron dist/electron/smoke.mjs",
    "package:msix": "node scripts/package-msix.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:violation": "node scripts/demo-violation.mjs",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
