node_modules/
dist/
.next/
out/
.data/
next-env.d.ts
*.tsbuildinfo
.env
.env.local

# MAR-429: generated packaging output. build/appx/AppxManifest.xml is the
# committed template; everything scripts/package-msix.mjs writes is not.
build/appx/packager-out/
build/appx/*.msix

# Claude Code's per-session state. `.claude/launch.json` is committed — it is a
# repo fact (dev server on an auto-selected port, because 3000 belongs to LAB).
# These two are one machine's, not the project's: `settings.local.json` holds
# whatever that operator happened to approve, and `worktrees/` is scratch.
.claude/settings.local.json
.claude/worktrees/

# `electron/capture.ts` prints a long, machine-specific transcript — window
# sizes, pipe names, this operator's own store path. The images and
# `layout.json` it writes are the evidence and are committed under
# `qa-screenshots-*/`; the log of the run that produced them is not.
capture-*.log

# MAR-586. `pnpm verify:shell` has to be redirected to a file rather than piped
# — piping it hangs on the surviving runner's stdout — so any session that runs
# the gate leaves one of these behind. Same reason as the capture log above: it
# is one machine's transcript, and the evidence a PR quotes is the exit status.
verify-shell-*.log

# The session-end ritual leaves DASH running, and launching it detached means
# its console has to go somewhere. Same reason again: one machine's transcript —
# this one names the pipe its runner is on and the store path it opened.
dash-launch.*.log

# MAR-583. Every capture harness is pointed at a scratch store through
# `DASH_DATA_DIR`, and pointing it inside the worktree is the convenient place
# to put one. It is a whole SQLite database plus an agents folder — one
# machine's, from one run, and never a repo fact. The evidence is the images
# beside it, which are committed.
scratch-*/
