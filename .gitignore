node_modules/
dist/
.next/
out/
.data/
next-env.d.ts
*.tsbuildinfo
.env
.env.local

# MAR-429: generated packaging output. build/appx/AppxManifest.xml is the
# committed template; everything scripts/package-msix.mjs writes is not.
build/appx/packager-out/
build/appx/*.msix

# Claude Code's per-session state. `.claude/launch.json` is committed — it is a
# repo fact (dev server on an auto-selected port, because 3000 belongs to LAB).
# These two are one machine's, not the project's: `settings.local.json` holds
# whatever that operator happened to approve, and `worktrees/` is scratch.
.claude/settings.local.json
.claude/worktrees/

# `electron/capture.ts` prints a long, machine-specific transcript — window
# sizes, pipe names, this operator's own store path. The images and
# `layout.json` it writes are the evidence and are committed under
# `qa-screenshots-*/`; the log of the run that produced them is not.
capture-*.log
