{
  "manifest_version": 2,
  "agent": {
    "name": "synthetic-ledger-reporter",
    "display_name": "Ledger Reporter",
    "goal": "Read a synthetic ledger with a DASH-held API key and summarise the week",
    "plan_source": "composed",
    "playbook_id": "",
    "route_id": "",
    "build_target": "code"
  },
  "planned_route": [
    { "step": 1, "component_id": "ledger_read", "risk_level": "low", "model_tier": "none" },
    { "step": 2, "component_id": "weekly_summary", "risk_level": "low", "model_tier": "small" }
  ],
  "safety_contract": {
    "automation_clearance": "L2",
    "enforced_approval_gates": [],
    "irreversible_components": []
  },
  "monitoring": {
    "events": ["run_started", "step_started", "step_completed", "run_completed", "run_failed"],
    "endpoint_env": "DASH_INGEST_URL",
    "token_env": "DASH_INGEST_TOKEN",
    "output_location": "DASH task output"
  },
  "provenance": {
    "generated_by": "synthetic MAR-383 example",
    "registry_fingerprint": "example-dash-managed-secret",
    "generated_at": "2026-07-29T19:00:00Z"
  },
  "agent_dom": {
    "dom_version": 1,
    "runtime": {
      "class": "local_process",
      "provider": "DASH Agent Runner",
      "label": "Bundled runner",
      "availability": "while_client_open",
      "continues_when_dash_closed": false
    },
    "trigger": { "type": "manual", "label": "Run when asked" },
    "locations": {
      "runtime": { "id": "bundled-runner", "label": "DASH Agent Runner", "kind": "local", "offline_behavior": "Stops when DASH stops" },
      "control": [
        { "id": "runner-control", "label": "Runner control endpoint", "kind": "local", "uri": "http://127.0.0.1/agent-dom", "offline_behavior": "DASH shows read-only state if the runner is not running" }
      ],
      "interaction": [
        { "id": "dash-workspace", "label": "DASH agent workspace", "kind": "dash", "offline_behavior": "Last safe state remains read-only" }
      ]
    },
    "connections": [
      {
        "id": "ledger",
        "provider": "synthetic-ledger",
        "label": "Ledger",
        "purpose": "Read the week's ledger entries so they can be summarised",
        "ownership": "dash_managed",
        "capabilities": [
          { "id": "ledger.entries.read", "label": "Read ledger entries", "access": "read" }
        ],
        "fields": [
          {
            "id": "api-key",
            "label": "Ledger API key",
            "purpose": "Read the week's ledger entries",
            "kind": "secret",
            "required": true,
            "help": "Create a read-only key in the ledger's settings page and paste it here. DASH stores it in this computer's credential vault.",
            "technical": { "environment_name": "LEDGER_API_KEY" }
          }
        ],
        "validation_action": { "id": "test-ledger-key", "label": "Test this key", "behavior": "test" }
      }
    ],
    "control": {
      "supported": true,
      "command_version": 1,
      "location_id": "runner-control",
      "commands": ["retry", "pause", "resume", "cancel"]
    },
    "memory": []
  }
}
