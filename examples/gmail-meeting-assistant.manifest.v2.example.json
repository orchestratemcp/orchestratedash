        "id": "calendar",
        "provider": "google-calendar",
        "label": "Google Calendar",
        "purpose": "Check availability and create an event only after approval",
        "ownership": "dash_managed",
        "capabilities": [
          { "id": "calendar.availability.read", "label": "Check calendar availability", "access": "read" },
          { "id": "calendar.events.create_after_approval", "label": "Create an approved calendar event", "access": "write" }
        ],
        "fields": [
          { "id": "calendar-account", "label": "Calendar account", "purpose": "Authorize availability checks and approved event creation", "kind": "oauth_reauthorization", "required": true, "help": "Reconnect and test this account. Existing OAuth credentials are not copied.", "technical": { "provider_scopes": ["https://www.googleapis.com/auth/calendar.readonly", "https://www.googleapis.com/auth/calendar.events"] } }
        ],
        "validation_action": { "id": "connect-calendar", "label": "Reconnect and test Calendar", "behavior": "reconnect_test_switch" }
      }
    ],
    "control": {
      "supported": true,
      "command_version": 1,
      "location_id": "meeting-control",
      "commands": ["approve", "reject", "choose", "retry", "pause", "resume", "cancel"]
