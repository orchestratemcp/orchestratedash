<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  MAR-431 (DASH-18c) — replaces the RT_MANIFEST resource @electron/packager's
  renamed .exe would otherwise keep as-is from electron.exe.

  This is Electron 43's own embedded manifest (extracted with resedit, the
  same library @electron/packager already depends on, from
  node_modules/electron/dist/electron.exe) with one structural change and one
  addition. win32metadata's "application-manifest" option does a wholesale
  byte replacement of the manifest resource (see @electron/packager's
  resedit.js), not a merge, so this file has to remain a complete, valid
  manifest on its own, not a fragment.

  Electron's own layout splits windowsSettings across two sibling
  <asmv3:windowsSettings> elements — disableWindowFiltering in one,
  dpiAware in the other. Valid XML, and the OS loader clearly tolerates it
  (the app launches fine either way), but it is almost certainly *why* WACK's
  DPIAwarenessValidation flagged this app as not DPI aware even before this
  issue: a checker that reads "the" windowsSettings element, rather than
  aggregating every sibling with that name, would find the first one
  (disableWindowFiltering only) and never see dpiAware sitting in the second.
  First fix attempt here added <dpiAwareness> into that same second block and
  WACK still failed identically — confirming the block-splitting itself, not
  a missing node, was the problem. Consolidated into one windowsSettings
  element below, matching Microsoft's own documented example layout, with
  <dpiAwareness> (2016 schema, PerMonitorV2) added alongside the existing
  <dpiAware> (2005 schema, kept for pre-1703 Windows — an OS new enough to
  read dpiAwareness uses it and ignores dpiAware, Microsoft's documented
  fallback pattern, not a conflict).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <disableWindowFiltering xmlns="http://schemas.microsoft.com/SMI/2011/WindowsSettings">true</disableWindowFiltering>
      <dpiAware>true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <maxversiontested Id="10.0.18362.0"/>
    </application>
  </compatibility>
</assembly>
